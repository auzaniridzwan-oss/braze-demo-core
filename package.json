{
  "name": "braze-demo-core",
  "version": "0.1.0",
  "description": "Shared core for Braze demo tools: field types and Braze rules, locale packs and identities, seeded RNG, endpoint allow-list and API proxy, plus React UI pieces.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "seedrandom": "^3.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/seedrandom": "^3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
